# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local y rellena los valores.
# En Vercel, los mismos nombres van en Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# 1. Base de datos (MongoDB Atlas, plan gratuito M0)
#    Atlas → Connect → Drivers → copia la cadena y cambia <password>.
MONGODB_URI="mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="finanza"

# 2. Acceso al panel (solo tú entras)
#    APP_PASSWORD es la clave que escribes al entrar.
#    AUTH_SECRET firma la sesión: genérala con  openssl rand -base64 32
APP_PASSWORD="una-clave-larga-que-solo-tu-sepas"
AUTH_SECRET="pega-aqui-32-caracteres-aleatorios"

# 3. Correo diario — elige UN proveedor
#    EMAIL_PROVIDER: "resend" o "smtp". Si lo dejas vacío se deduce solo.
EMAIL_PROVIDER="resend"

#    Opción A — Resend (gratis 3.000 correos/mes, sin dominio propio)
#    Con el remitente onboarding@resend.dev solo puedes escribirte a ti mismo,
#    que es justo lo que necesitas aquí.
RESEND_API_KEY=""
EMAIL_FROM="Finanza <onboarding@resend.dev>"

#    Opción B — SMTP de Gmail (gratis, con contraseña de aplicación)
#    Google → Cuenta → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# 4. Disparo diario del correo
#    CRON_SECRET autoriza la llamada a /api/cron/recordatorios.
#    Genérala con  openssl rand -hex 24
CRON_SECRET=""

# 5. URL pública de la app (el botón del correo apunta aquí)
APP_URL="https://tu-app.vercel.app"

# 6. Zona horaria para "hoy" y los vencimientos
TZ_APP="America/Bogota"

# 7. Correo de respaldo si todavía no lo guardaste en Ajustes (opcional)
REMINDER_EMAIL=""
